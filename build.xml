<?xml version="1.0" encoding="UTF-8" ?>
<project name="NShop" default="all" basedir=".">
    <property name="src-dir" location="src"/>
    <property name="dist-dir" location="dist"/>
    <property name="lib-dir" location="${dist-dir}/libraries"/>
    <property name="class-dir" location="${dist-dir}/classes"/>

    <property name="version" value="1.0.2"/>

    <target name="clean">
        <delete dir="${dist-dir}"/>
    </target>

    <target name="init" description="添加依赖">
        <mkdir dir="${lib-dir}"/>
        <mkdir dir="${class-dir}"/>

        <get src="https://getbukkit.org/craftbukkit/craftbukkit-1.13.jar" dest="${lib-dir}/bukkit.jar"/>
        <get src="https://ci.ender.zone/job/EssentialsX/lastSuccessfulBuild/artifact/jars/EssentialsX-2.22.1-dev+28-f8724e2.jar" dest="${lib-dir}/EssentialsX.jar"/>
        <get src="https://github.com/MilkBowl/Vault/releases/download/1.7.3/Vault.jar" dest="${lib-dir}/Vault.jar"/>
    </target>

    <target name="compile" description="构建">
        <javac srcdir="${src-dir}" destdir="${class-dir}" includeantruntime="false"
               release="8" encoding="UTF-8">
            <classpath>
                <fileset dir="${lib-dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
        </javac>
    </target>

    <target name="jar" depends="compile" description="构建">
        <jar jarfile="${dist-dir}/${ant.project.name}-${version}.jar">
            <fileset dir="${class-dir}"/>
            <fileset file="plugin.yml"/>
            <fileset file="config.yml"/>
        </jar>
    </target>

    <target name="all" depends="clean, init, jar" description="一件完成" />

</project>